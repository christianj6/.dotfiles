# template for .zshrc (extend with your own things)
#
# setup.sh installs/keeps current, automatically (see README):
#   - claude/opencode functions, claude-setup/opencode-setup commands
#   - the ranger alias (". ranger", so quitting ranger cds your shell there)
#   - openjdk/openjdk@21 PATH entries (macOS)
#   - the conda-in-tmux persistence trick (conda init's block, wrapped in the
#     CONDA_SHLVL guard, plus sourcing conda.sh directly for tmux panes)
# No need to copy any of that in here.
#
# Everything below is copy-paste only -- setup.sh never touches it -- kept
# here so a fresh machine can be brought back to "the way I like it" by hand.

# --- project navigation aliases ---
# cd into a marked project and the env seam activates its conda env
# automatically (a .conda-env file in the project root names the env); herdr
# panes in marked projects even open nvim on their own. Per-project aliases
# are optional sugar:
# alias myproject="cd ~/path/to/myproject"
alias zshrc="nvim ~/.zshrc"

# --- other aliases ---
# alias ls="tree -L 1"
# alias mytool="tool-command"

# --- secrets (fill in per machine -- never commit real values here) ---
# Bitwarden CLI (`bw`) auth.
export BW_CLIENTID=""
export BW_CLIENTSECRET=""

# --- PATH additions for manually-installed apps (see README) ---
export PATH="/Applications/Wireshark.app/Contents/MacOS:$PATH"
