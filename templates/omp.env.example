# Copy to ~/.omp/agent/.env (not this file's own location) and fill in the
# real value. omp auto-loads .env from <cwd>/.env, ~/.omp/agent/.env,
# ~/.omp/.env, or ~/.env (first found wins, live process env always takes
# priority) -- ~/.omp/agent/.env is the recommended spot since it sits next
# to config.yml.
OPENROUTER_API_KEY=
