# Discord bridge configuration for the agent-discord plugin.
# Fill in one of these locations (BOTH are loaded; the config dir wins):
#   a) the plugin CONFIG dir (documented home for credentials):
#      ~/.config/herdr/plugins/config/dotfiles.agent-discord/.env
#   b) this plugin root, next to this template (gitignored -- safe for
#      the token): config/herdr/plugins/agent-discord/.env
#
# Required:
#   Bot token from discord.com/developers -> your app -> Bot -> Reset Token
#   (the bot needs the MESSAGE CONTENT intent enabled on the same page)
DISCORD_BOT_TOKEN=
#
# Comma-separated Discord user IDs allowed to relay commands into agents
# (Developer Mode -> right-click your name -> Copy User ID). Empty = nobody
# can relay; notifications always go to the channels regardless.
DISCORD_ALLOWLIST_USER_IDS=
#
# Optional:
# Server ID if the bot is in more than one server (Developer Mode ->
# right-click server icon -> Copy Server ID). Auto-picked when it is in
# exactly one.
#DISCORD_GUILD_ID=
# Category the per-agent channels are created under.
#DISCORD_CATEGORY_NAME=herdr agents
# Fallback webhook used by notify.py before the bot has provisioned a
# per-agent channel (Server Settings -> Integrations -> Webhooks -> New).
#DISCORD_NOTIFY_WEBHOOK=
