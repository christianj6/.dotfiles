# Discord bridge (agent-discord plugin): template. Put real values in
#   ~/.config/herdr/plugins/config/dotfiles.agent-discord/.env   (setup.sh seeds it)
# An empty KEY= line is ignored by the loader, but setup's seed comments every
# key out anyway, so a copy can never shadow a value set elsewhere.

# ─── Discord bot ────────────────────────────────────────────────────────────
# What: the gateway bot that relays your channel messages into the agents.
# Without it: notifications still arrive (webhooks); replies do nothing.

DISCORD_BOT_TOKEN=            # required · discord.com/developers → app → Bot → Reset Token (enable MESSAGE CONTENT intent)
DISCORD_ALLOWLIST_USER_IDS=   # required · your user id(s), comma-separated (Developer Mode → right-click name → Copy User ID); empty = nobody can relay

# ─── Discord server layout ──────────────────────────────────────────────────
#DISCORD_GUILD_ID=            # optional · only if the bot is in 2+ servers (right-click server icon → Copy Server ID)
#DISCORD_CATEGORY_NAME=herdr agents   # optional · category the per-agent channels go under

# ─── Notifications ──────────────────────────────────────────────────────────
#DISCORD_NOTIFY_WEBHOOK=      # optional · fallback webhook before the bot has provisioned a channel
