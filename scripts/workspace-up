#!/usr/bin/env python3
"""Bring every long-running workspace piece up, from the current code.

    python3 scripts/workspace-up [--dry-run] [--only name,name]

For each piece (lifeview daemon, discord bot, prescient server, bro serve):
  - not running            -> start it (detached, from the current code);
  - code newer than process -> restart it (newest mtime of the files it runs vs
                              the process start time: no version file to forget);
  - then a health check that tests what matters, not just "a pid exists".
Then every omp in a herdr pane (--only omp for just these): its last logged
compaction decision must match config/omp (window known, thresholdTokens as
configured). A stale one is named as "needs you", never restarted from here.
Idempotent: a second run finds everything running and fresh and does nothing.
Prints one line per piece and ends with one summary naming anything that needs
the owner (a secret to fill in, a piece with no launcher), with copy-paste
lines. Never prints a secret value. Exit 0 when nothing needs the owner, 1
otherwise (setup.sh treats it as non-fatal).

Repo locations are never hard-coded (this repo is public). They come from the
local, unversioned config the plugins already read:
  prescient repo = PRESCIENT_REPO, else the parent of PRESCIENT_DATA_DIR
  bro repo       = BRO_REPO, else three levels up from BRO_BIN (<repo>/.venv/bin/bro)
both looked up in the env, then in lifeview-fallback's lifeview.env.
"""

from __future__ import annotations

import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Optional

DOTFILES = Path(__file__).resolve().parents[1]
PLUGINS = DOTFILES / "config" / "herdr" / "plugins"
LIFEVIEW_ENV = Path.home() / ".config/herdr/plugins/config/dotfiles.lifeview-fallback/lifeview.env"
DISCORD_ENV = Path.home() / ".config/herdr/plugins/config/dotfiles.agent-discord/.env"
LOG_DIR = Path("/tmp")


def conf(key: str) -> str:
    v = os.environ.get(key, "").strip()
    if v:
        return os.path.expanduser(os.path.expandvars(v))
    try:
        for ln in LIFEVIEW_ENV.read_text().splitlines():
            k, _, val = ln.partition("=")
            if k.strip() == key and val.strip():
                return os.path.expanduser(os.path.expandvars(val.strip()))
    except OSError:
        pass
    return ""


def prescient_repo() -> Optional[Path]:
    r = conf("PRESCIENT_REPO") or (str(Path(conf("PRESCIENT_DATA_DIR")).parent) if conf("PRESCIENT_DATA_DIR") else "")
    return Path(r) if r and Path(r, ".venv/bin/prescient").exists() else None


def bro_repo() -> Optional[Path]:
    r = conf("BRO_REPO") or (str(Path(conf("BRO_BIN")).parents[2]) if conf("BRO_BIN") else "")
    return Path(r) if r and Path(r, ".venv/bin/bro").exists() else None


# ---- processes ----

@dataclass
class Proc:
    pid: int
    started: float
    command: str


def processes() -> list[Proc]:
    out = subprocess.run(["ps", "-axo", "pid=,lstart=,command="], capture_output=True, text=True).stdout
    procs = []
    for ln in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\w{3} \w{3}\s+\d+ \d\d:\d\d:\d\d \d{4})\s+(.*)$", ln)
        if m:
            try:
                started = time.mktime(time.strptime(m.group(2), "%a %b %d %H:%M:%S %Y"))
            except ValueError:
                continue
            procs.append(Proc(int(m.group(1)), started, m.group(3)))
    return procs


def newest_mtime(paths: list[Path]) -> tuple[float, Optional[Path]]:
    best, which = 0.0, None
    for p in paths:
        files = p.rglob("*.py") if p.is_dir() else [p]
        for f in files:
            try:
                m = f.stat().st_mtime
            except OSError:
                continue
            if m > best:
                best, which = m, f
    return best, which


def get(url: str, timeout: float = 3) -> tuple[Optional[int], dict]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as res:
            body = res.read()
            try:
                return res.status, json.loads(body)
            except ValueError:
                return res.status, {}
    except urllib.error.HTTPError as e:
        return e.code, {}
    except Exception:
        return None, {}


def age(seconds: float) -> str:
    s = max(0, int(seconds))
    return f"{s // 86400}d" if s >= 86400 else f"{s // 3600}h" if s >= 3600 else f"{s // 60}m" if s >= 60 else f"{s}s"


# ---- pieces ----

@dataclass
class Piece:
    name: str
    match: str                                   # regex over the ps command line
    code: Callable[[], list[Path]]               # what it runs (dirs: every *.py under them)
    launch: Callable[[], Optional[tuple[list[str], Path, dict]]]   # (argv, cwd, extra env) or None
    no_launcher: str = ""                        # what to tell the owner when launch() is None
    health: Callable[[float], tuple[bool, str, list[str]]] = lambda started: (True, "", [])   # ok, detail, owner lines
    ready: Callable[[], bool] = lambda: True     # after a start: answers yet?
    needs: list[str] = field(default_factory=list)
    lock: Optional[Path] = None                  # its singleton lock: the file names the SERVING pid


# ---- which process serves ----
# A locked piece's hooks fire short-lived launches that exit on the lock. While
# one is in flight it is the NEWEST match, so judging the newest match compared
# the code against a doomed launch and never restarted the stale daemon behind
# it (2026-11-19: "running (pid 54127) up 0s" while 20359 served stale code).
# The lock file names the pid that actually serves (_shared/singleton.py).

PLUGIN_STATE = Path.home() / ".local" / "state" / "herdr" / "plugins"
SHARED = PLUGINS / "_shared" / "singleton.py"   # every locked piece runs it too


def lock_pid(path: Optional[Path]) -> Optional[int]:
    try:
        return int(path.read_text().strip()) if path else None
    except (OSError, ValueError):
        return None


def serving(procs: list[Proc], lock: Optional[Path]) -> tuple[Optional[Proc], str]:
    """(the process to judge, a note for the line). The lock holder when the
    lock names a live matching process; otherwise the newest match, saying why.
    No lock (prescient, bro): the newest match, as always."""
    if not procs:
        return None, ""
    newest = max(procs, key=lambda x: x.started)
    if lock is None:
        return newest, ""
    pid = lock_pid(lock)
    if pid is None:
        return newest, "no pid in the lock file; judged the newest match"
    holder = next((x for x in procs if x.pid == pid), None)
    if holder is None:
        return newest, f"lock names pid {pid}, which is not running; judged the newest match"
    others = sorted(x.pid for x in procs if x.pid != pid)
    if not others:
        return holder, ""
    return holder, "lock holder; " + ", ".join(map(str, others)) + (" launch" if len(others) == 1 else " launches") + " in flight"


def health_lifeview(started: float = 0) -> tuple[bool, str, list[str]]:
    # what broke on 2026-11-11: the daemon could not authenticate its hub writes
    code = ("import lifeview as lv; t, p = lv.hub_token(); "
            "print('ok' if t else 'NO ' + p)")
    r = subprocess.run([sys.executable, "-c", code], cwd=PLUGINS / "lifeview-fallback",
                       capture_output=True, text=True, timeout=20)
    line = (r.stdout.strip().splitlines() or ["NO no answer"])[-1]
    if line == "ok":
        return True, "hub token found", []
    return False, line[3:], [f"lifeview: {line[3:]}"]


BRIDGE_LOG = Path(os.environ.get("HERDR_PLUGIN_STATE_DIR")
                  or Path.home() / ".local/state/herdr/plugins/dotfiles.agent-discord") / "bridge.log"


def bot_ready_since(started: float, wait: float = 15) -> bool:
    """The running bot logged `bot ready` after it started: its gateway is up.

    Reads the whole log, not a tail: a bot up for days pushes its last
    `bot ready` thousands of `notified` lines back (2026-11-18: ready at line
    2579 of 2995, outside the old 400-line tail -> a healthy bot was reported
    as never ready)."""
    deadline = time.time() + wait
    while True:
        try:
            for ln in reversed(BRIDGE_LOG.read_text(errors="replace").splitlines()):
                m = re.match(r"\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] bot ready", ln)
                if m and time.mktime(time.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")) >= started - 1:
                    return True
        except OSError:
            pass
        if time.time() >= deadline:
            return False
        time.sleep(1)


def bot_connected() -> bool:
    """Live-operation evidence: the running bot holds an established TCPS
    connection (the gateway websocket). Covers a ready line lost to log
    rotation or truncation."""
    for p in processes():
        if re.search(r"agent-discord/bot\.py", p.command):
            out = subprocess.run(["lsof", "-a", "-p", str(p.pid), "-i", "TCP:443", "-sTCP:ESTABLISHED", "-n", "-P"],
                                 capture_output=True, text=True).stdout
            if "ESTABLISHED" in out:
                return True
    return False


def health_discord(started: float = 0) -> tuple[bool, str, list[str]]:
    r = subprocess.run([sys.executable, "selfcheck.py", "--live"], cwd=PLUGINS / "agent-discord",
                       capture_output=True, text=True, timeout=60)
    fails = [ln[5:] for ln in r.stdout.splitlines() if ln.startswith("FAIL ")]
    live = "bot ready"
    if not fails and started and not bot_ready_since(started):
        if bot_connected():
            live = "no `bot ready` since start, but the gateway connection is up"
        else:
            fails = [f"gateway: the running bot never logged `bot ready` since it started and holds no "
                     f"gateway connection (see {BRIDGE_LOG})"]
    if not fails:
        n = sum(1 for ln in r.stdout.splitlines() if ln.startswith("PASS channel"))
        return True, f"token ok, {n} channels resolve, Discord connects, {live}", []
    owner = []
    for f in fails:
        m = re.search(r"\(run: (.*)\)$", f)
        owner.append(f"discord: {f.split(' - ')[0]}" + (f"\n      run: {m.group(1)}" if m else ""))
    return False, "; ".join(f.split(" (run:")[0] for f in fails), owner


def http_health(url: str, check: Callable[[dict], bool], what: str) -> Callable[[], tuple[bool, str, list[str]]]:
    def h(started: float = 0) -> tuple[bool, str, list[str]]:
        status, body = get(url)
        if status == 200 and check(body):
            return True, f"{what} answers 200", []
        return False, f"{what} answered {status or 'nothing'}", []
    return h


def launch_prescient():
    repo = prescient_repo()
    if not repo:
        return None
    # its own launcher (tools/restart-servers.sh) sources .env with set -a; do the same,
    # but start only 8765 (that script also kills and restarts the 8917 test server)
    cmd = 'set -a; [ -f .env ] && . ./.env; set +a; exec .venv/bin/prescient gantt serve --port 8765 --no-open'
    return ["bash", "-c", cmd], repo, {}


def launch_bro():
    repo = bro_repo()
    return (["bash", "-c", "exec .venv/bin/bro serve"], repo, {}) if repo else None


PIECES = [
    Piece("lifeview", r"lifeview\.py --daemon",
          lambda: [PLUGINS / "lifeview-fallback" / "lifeview.py", SHARED],
          lambda: ([sys.executable, "lifeview.py", "--daemon"], PLUGINS / "lifeview-fallback", {}),
          health=health_lifeview, lock=PLUGIN_STATE / "dotfiles.lifeview-fallback" / "lock"),
    Piece("discord-bot", r"agent-discord/bot\.py",
          lambda: [PLUGINS / "agent-discord" / "bot.py", PLUGINS / "agent-discord" / "common.py", SHARED],
          lambda: (["bash", "run-bot.sh"], PLUGINS / "agent-discord", {"HERDR_DISCORD_DETACHED": "1"}),
          health=health_discord, lock=PLUGIN_STATE / "dotfiles.agent-discord" / "lock"),
    # The other two singleton-locked plugin daemons. Launched by absolute path so
    # the started process matches the same regex as herdr's own launch.
    Piece("omp-watch", r"omp-watch/watch\.py",
          lambda: [PLUGINS / "omp-watch" / "watch.py", SHARED],
          lambda: ([sys.executable, str(PLUGINS / "omp-watch" / "watch.py"), "--daemon"], PLUGINS / "omp-watch", {}),
          lock=PLUGIN_STATE / "dotfiles.omp-watch" / "lock"),
    Piece("claude-name", r"claude-name/names\.py|names\.py --daemon",
          lambda: [PLUGINS / "claude-name" / "names.py", SHARED],
          lambda: ([sys.executable, str(PLUGINS / "claude-name" / "names.py"), "--daemon"], PLUGINS / "claude-name", {}),
          lock=PLUGIN_STATE / "dotfiles.claude-name" / "lock"),
    Piece("prescient", r"prescient gantt serve --port 8765\b",
          lambda: [prescient_repo() / "prescient"] if prescient_repo() else [],
          launch_prescient,
          no_launcher="prescient: repo unknown - put PRESCIENT_DATA_DIR=<prescient>/data (or PRESCIENT_REPO=) in " + str(LIFEVIEW_ENV),
          health=http_health("http://127.0.0.1:8765/api/health",
                             lambda b: (b.get("write_token") or {}).get("guarded") is True, "/api/health"),
          ready=lambda: get("http://127.0.0.1:8765/api/health")[0] == 200),
    Piece("bro", r"bro serve\b",
          lambda: [bro_repo() / "bro"] if bro_repo() else [],
          launch_bro,
          no_launcher="bro: repo unknown - put BRO_BIN=<bro>/.venv/bin/bro (or BRO_REPO=) in " + str(LIFEVIEW_ENV),
          health=http_health("http://127.0.0.1:8766/health", lambda b: b.get("ok") is True, "/health"),
          ready=lambda: get("http://127.0.0.1:8766/health")[0] == 200),
]


# ---- omp panes: the live compaction settings must be the configured ones ----
# Same class as a service older than its code: an omp process loads config.yml
# and models.yml once, at start, so a pane started before a config change keeps
# the old values until its omp restarts. Seen 2026-11-18: three panes from
# Nov 12 ran contextWindow 0 / thresholdTokens 0 (never compacts) or the old
# 660k after the 500k fix had shipped. The truth is the process's own log:
# omp writes "Auto-compaction threshold decision" (contextWindow,
# thresholdTokens) after every turn. Report only, never restart: an agent's
# REPL may be mid-turn or hold typed input, and restarting it is a judgment
# call (the yarepl /exit + ctrl+a path), not a startup-hook action.

OMP_CONFIG = DOTFILES / "config" / "omp"
OMP_LOGS = Path.home() / ".omp" / "logs"
OMP_DECISION = "Auto-compaction threshold decision"


@dataclass
class OmpPane:
    pid: int
    started: float
    pane: str        # HERDR_PANE_ID, from the process env
    project: str     # cwd basename


def omp_threshold_config() -> int:
    """compaction.thresholdTokens from config.yml (0 = unset)."""
    try:
        txt = (OMP_CONFIG / "config.yml").read_text()
    except OSError:
        return 0
    m = re.search(r"^compaction:[ \t]*\n(?:(?:[ \t]+.*|[ \t]*#.*|)\n)*?[ \t]+thresholdTokens:[ \t]*(\d+)", txt, re.M)
    return int(m.group(1)) if m else 0


def omp_panes() -> list[OmpPane]:
    """Interactive omp processes inside herdr panes (ps -E shows the env)."""
    out = subprocess.run(["ps", "-E", "-ww", "-axo", "pid=,command="], capture_output=True, text=True).stdout
    starts = {p.pid: p.started for p in processes()}
    panes = []
    for ln in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(.*)$", ln)
        if not m or not re.search(r"/bin/omp(\s|$)", m.group(2)) or re.search(r"/bin/omp\s+(-p|--print)\b", m.group(2)):
            continue
        pane = re.search(r"\bHERDR_PANE_ID=(\S+)", m.group(2))
        pid = int(m.group(1))
        if not pane or pid not in starts:
            continue
        cwd = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                             capture_output=True, text=True).stdout
        cwd = next((l[1:] for l in cwd.splitlines() if l.startswith("n")), "")
        panes.append(OmpPane(pid, starts[pid], pane.group(1), Path(cwd).name or "?"))
    return sorted(panes, key=lambda p: p.pane)


def omp_decision(pid: int, started: float, logs: Path = OMP_LOGS) -> Optional[tuple[int, int]]:
    """(contextWindow, thresholdTokens) of this process's newest logged decision."""
    day0 = time.strftime("%Y-%m-%d", time.localtime(started))
    for f in sorted(logs.glob(f"omp.*.{pid}.log"), reverse=True):
        if f.name.split(".")[1] < day0:          # a recycled pid's old log
            continue
        try:
            lines = f.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for ln in reversed(lines):
            if OMP_DECISION not in ln:
                continue
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            return int(d.get("contextWindow") or 0), int(d.get("thresholdTokens") or 0)
    return None


def omp_verdict(p: OmpPane, want: int, config_m: float,
                decision: Callable[[int, float], Optional[tuple[int, int]]] = omp_decision) -> tuple[bool, str]:
    """(ok, detail). Not ok = the pane is not running the configured compaction."""
    d = decision(p.pid, p.started)
    if d is None:
        if p.started + 1 < config_m:
            return False, f"no turn logged, started {age(config_m - p.started)} before the omp config changed"
        return True, "no turn logged yet, started after the config"
    window, thr = d
    if window <= 0:
        return False, f"contextWindow 0: never compacts (config {want})"
    expect = min(want, window - 1) if want > 0 else thr
    if thr != expect:
        return False, f"threshold {thr} vs config {expect}"
    return True, f"window {window}, threshold {thr}"


def check_omp(panes: list[OmpPane], out, decision=omp_decision) -> list[str]:
    """One line per omp pane; returns the owner lines for the stale ones."""
    want = omp_threshold_config()
    config_m, _ = newest_mtime([OMP_CONFIG / "config.yml", OMP_CONFIG / "models.yml"])
    owner = []
    now = time.time()
    for p in panes:
        ok, detail = omp_verdict(p, want, config_m, decision)
        out(f"omp {p.pane:<8} {p.project[:16]:<16} pid {p.pid:<6} up {age(now - p.started):<4} "
            f"{'ok' if ok else 'STALE'}: {detail}")
        if not ok:
            owner.append(f"omp {p.pane} ({p.project}): {detail} - restart its omp (/exit, then ctrl+a in the pane)")
    return owner


def start(p: Piece, dry: bool) -> str:
    spec = p.launch()
    if spec is None:
        return "no launcher"
    if dry:
        return "would start"
    argv, cwd, extra = spec
    log = open(LOG_DIR / f"workspace-up-{p.name}.log", "a")
    subprocess.Popen(argv, cwd=cwd, env={**os.environ, **extra}, stdin=subprocess.DEVNULL,
                     stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(40):                       # up to ~20 s for it to appear and answer
        time.sleep(0.5)
        if any(re.search(p.match, x.command) for x in processes()) and p.ready():
            return "started"
    return "started (not answering yet)"


def stop(proc: Proc) -> bool:
    try:
        os.kill(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    for _ in range(20):
        time.sleep(0.5)
        try:
            os.kill(proc.pid, 0)
        except ProcessLookupError:
            return True
    try:
        os.kill(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return True


def run(pieces: list[Piece], dry: bool, out=print, omp: Optional[list[OmpPane]] = None,
        decision=omp_decision) -> int:
    counts = {"running": 0, "started": 0, "stale": 0, "restarted": 0, "unhealthy": 0}
    owner: list[str] = []
    now = time.time()
    for p in pieces:
        code_m, code_f = newest_mtime(p.code())
        procs = [x for x in processes() if re.search(p.match, x.command)]
        action = ""
        if not procs:
            action = start(p, dry)
            if action == "no launcher":
                owner.append(p.no_launcher or f"{p.name}: no launcher")
                out(f"{p.name:<12} DOWN          no launcher                 needs you")
                continue
            if action.startswith("started"):
                counts["started"] += 1
        else:
            proc, note = serving(procs, p.lock)
            if code_m > proc.started + 1:
                why = f"code {age(code_m - proc.started)} newer than process ({code_f.name if code_f else '?'})"
                if dry:
                    action = f"would restart: {why}"
                    counts["stale"] += 1
                else:
                    for x in procs:
                        stop(x)
                    action = "restarted: " + why + " -> " + start(p, dry)
                    counts["restarted"] += 1
        procs = [x for x in processes() if re.search(p.match, x.command)]
        if procs:
            proc, note = serving(procs, p.lock)
            ok, detail, need = p.health(proc.started)
            owner += need
            counts["running"] += 1
            if not ok:
                counts["unhealthy"] += 1
            pid = f"{proc.pid} {note}" if note else f"{proc.pid:<6}"
            out(f"{p.name:<12} running (pid {pid}) up {age(now - proc.started):<4} "
                f"code {age(now - code_m) if code_m else '?':<4} old   {'ok' if ok else 'UNHEALTHY'}: {detail}"
                + (f"   [{action}]" if action else ""))
        else:
            out(f"{p.name:<12} DOWN          {action or 'not running'}")
            if not dry:
                counts["unhealthy"] += 1
    omp_stale = check_omp(omp, out, decision) if omp is not None else []
    owner += omp_stale
    summary = (f"workspace: {counts['running']} running, {counts['started']} started, "
               f"{counts['stale']} stale, {counts['restarted']} restarted, {counts['unhealthy']} unhealthy, "
               + (f"{len(omp_stale)} omp stale, " if omp is not None else "") + f"{len(owner)} need you")
    out(summary + ((" - " + "; ".join(o.splitlines()[0] for o in owner)) if owner else ""))
    for o in owner:
        out("  " + o)
    return 1 if owner or counts["unhealthy"] else 0


def main(argv: list[str]) -> int:
    dry = "--dry-run" in argv
    only = next((a.split("=", 1)[1] if "=" in a else argv[argv.index(a) + 1] for a in argv if a.startswith("--only")), "")
    pieces = [p for p in PIECES if not only or p.name in only.split(",")]
    omp = omp_panes() if not only or "omp" in only.split(",") else None
    return run(pieces, dry, omp=omp)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
