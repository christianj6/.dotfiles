# Copy to .env (repo root) and fill in real values.
# .env is gitignored — never commit real secrets here.

# --- aider (https://aider.chat) -------------------------------------------
# Read automatically by the aider CLI that setup.sh installs. Full list of
# options: https://aider.chat/docs/config/dotenv.html
AIDER_MODEL=
AIDER_WEAK_MODEL=
AIDER_AUTO_COMMITS=
AIDER_WATCH_FILES=
AIDER_SHOW_MODEL_WARNINGS=

# --- Trello (scripts/trello-notes) ----------------------------------------
# API key + token from https://trello.com/power-ups/admin
TRELLO_KEY=
TRELLO_TOKEN=
# Not read by any script here today; kept for manual/future use.
TRELLO_SECRET=

# --- OpenAI (scripts/trello-notes/llm_note_sorter.py) ----------------------
OPENAI_API_KEY=

# --- GitHub -----------------------------------------------------------------
# Not read by any script here today; kept for manual/future use.
GITHUB_PAT=
